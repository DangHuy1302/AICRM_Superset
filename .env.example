# ==============================================================================
# Northstar CRM - Environment Configuration Template (.env.example)
# Bài thực hành TH2: Hệ thống Phân tích Dữ liệu Thông minh với AI & Apache Superset
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django / Wagtail Core Settings
# ------------------------------------------------------------------------------
# Khóa bí mật Django (Trong môi trường dev/demo có thể dùng mặc định, production bắt buộc đổi)
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here-change-in-production

# Chế độ Debug (True cho môi trường lập trình và thử nghiệm demo, False cho production)
DEBUG=True

# Danh sách host được phép truy cập, ngăn cách bằng dấu phẩy
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Settings
# ------------------------------------------------------------------------------
# Khóa API Google AI Studio / Gemini API
# Lưu ý: Khi để trống, hệ thống CRM hoạt động ở chế độ Graceful Degradation (Fallback an toàn):
# - Nhãn khách hàng giữ nguyên nhãn hiện tại hoặc báo "Chưa phân loại"
# - Bảng kiểm toán CustomerAIAnalysis ghi nhận trạng thái 'skipped'
# - Mô hình chấm điểm Lead (Lead Scoring) vẫn chạy 100% nhờ động cơ Scikit-learn Machine Learning nội bộ
GEMINI_API_KEY=

# Phiên bản / Tên model Gemini ưu tiên (Mặc định khuyến nghị: gemini-2.5-flash hoặc gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# Phiên bản API Gemini (Mặc định: v1beta)
GEMINI_API_VERSION=v1beta

# ------------------------------------------------------------------------------
# 3. Apache Superset Settings (Môi trường Host kết nối Container)
# ------------------------------------------------------------------------------
# Cổng web Superset trên Windows host (mặc định trong docker-compose: 8089)
SUPERSET_PORT=8089

# Cổng FastMCP Streamable HTTP trên Windows host (mặc định trong docker-compose: 5008)
SUPERSET_MCP_PORT=5008

# Tài khoản Admin mặc định để đăng nhập giao diện BI Superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

